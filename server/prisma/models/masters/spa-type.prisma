model SpaCategory {
    id   String @id @default(uuid())
    name String @unique @map("name")

    SpaSubCategories SpaSubCategory[]
    SpaServices      Spa[]

    @@map("spa_category")
}

model SpaSubCategory {
    id          String      @id @default(uuid())
    name        String      @map("name")
    categoryId  String      @map("category_id")
    isActive    Boolean     @map("is_active")
    Category    SpaCategory @relation(fields: [categoryId], references: [id],onDelete: Cascade)
    SpaServices Spa[]
    @@unique([categoryId,name])
    @@map("spa_sub_category")
}
