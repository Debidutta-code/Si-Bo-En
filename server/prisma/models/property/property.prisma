model Property {
  id                  String                       @id @default(uuid())
  propertyName        String                       @map("property_name")
  propertyEmail       String                       @map("property_email")
  propertyContact     String                       @map("property_contact")
  propertyCode        String                       @unique @map("property_code")
  description         String
  image               String[]
  starRating          Float?                       @map("star_rating")
  isDraft             Boolean                      @default(true) @map("is_draft")
  isAvailable         Boolean                      @default(true) @map("is_available")
  isDeleted           Boolean                      @default(false) @map("is_deleted")
  createdById         String                       @map("created_by_id")
  creationId          String                       @unique @map("creation_id")
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  addOns              Addon[]
  AddonCategories     AddonCategory[]
  AddonSubCategories  AddonSubCategory[]
  AddonVariants       AddonVariant[]
  propertyEmails      PropertyEmails[]
  agenticProperties   AgenticProperty[]
  bankDetails         BankDetails?
  bookingEngineConfig BookingEngineConfigurations?
  bookingOffsets      BookingOffset[]
  Reviews             Review[]
  WishLists           WishList[]
  customizableDeals   CustomizableDeal[]
  geoRatePlans        GeoRatePlan[]
  Guests              Guests[]
  payments            Payment[]
  Policy              Policy[]
  ProblemTickets      ProblemTickets[]

  promoCodes                  PromoCode[]
  promotions                  Promotion[]
  createdBy                   User                         @relation("PropertyCreatedBy", fields: [createdById], references: [id])
  creation                    Creation                     @relation(fields: [creationId], references: [id] )
  propertyAddress             PropertyAddress?
  propertyAmenities           PropertyAmenitySelection[]
  propertyCategory            PropertyCategory?
  Commissions                 PropertyCommission?
  propertyConfigs             PropertyConfigs?
  propertyIntegrations        PropertyIntegrations[]
  loyaltyProgramConfig        PropertyLoyaltyConfig?
  propertyPaymentIntegrations PropertyPaymentIntegration[]
  propertyType                PropertyType?
  propertyVideos              PropertyVideo?
  ratePlans                   RatePlan[]
  reservations                Reservation[]
  propertyRooms               Room[]
  Spa                         Spa[]
  ActiveLanguage              PropertyActiveLanguages[]
  
  taxGroups                   TaxGroup[]                   @relation("PropertyTaxGroups")
  taxRules                    TaxRule[]                    @relation("PropertyTaxRules")

  @@index([createdById])
  @@index([creationId])
  @@index([propertyCode])
  @@map("properties")
}
