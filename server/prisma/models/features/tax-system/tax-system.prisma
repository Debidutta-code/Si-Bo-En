model TaxRule {
  id            String          @id @default(uuid()) @map("id")
  name          String          @map("name") @db.VarChar(100)
  type          TaxType         @map("type")
  value         Float           @map("value")
  applicableOn  TaxApplicableOn @map("applicable_on")
  description   String?         @map("description")
  isInclusive   Boolean         @default(false) @map("is_inclusive")
  priority      Int             @default(0) @map("priority")
  currencyCode  CurrencyCode    @default(AED) @map("currency_code")
  propertyId    String          @map("property_id")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  taxGroupRules TaxGroupRule[]
  property      Property        @relation("PropertyTaxRules", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("tax_rules")
}

model TaxGroup {
  id            String         @id @default(uuid()) @map("id")
  name          String         @map("name") @db.VarChar(100)
  isActive      Boolean        @default(false) @map("is_active")
  propertyId    String         @map("property_id")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  ratePlans     RatePlan[]
  taxGroupRules TaxGroupRule[]
  property      Property       @relation("PropertyTaxGroups", fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("tax_groups")
}

model TaxGroupRule {
  id         String   @id @default(uuid()) @map("id")
  taxGroupId String   @map("tax_group_id")
  taxRuleId  String   @map("tax_rule_id")
  taxGroup   TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)
  taxRule    TaxRule  @relation(fields: [taxRuleId], references: [id], onDelete: Cascade)

  @@unique([taxGroupId, taxRuleId])
  @@map("tax_group_rules")
}
