model CreationLoyaltyConfig {
    id         String   @id @default(uuid())
    creationId String   @unique @map("creation_id")
    Creation   Creation @relation(fields: [creationId], references: [id])

    loyaltyDiscountType DiscountType  @default(percentage) @map("loyalty_discount_type")
    discountValue       Int           @map("discount_value")
    currencyCode        CurrencyCode? @default(INR) @map("currency_code")

    BasicLoyaltyProgram      BasicLoyaltyProgram?
    AdvanceLoyaltyProgram    AdvanceLoyaltyProgram?
    loyaltyConditions        LoyaltyConditions[]
    loyaltySpecialConditions LoyaltySpecialCondition[]

    LoyaltyProgramFieldConfig LoyaltyProgramFieldConfig[]
    CreationGuest            CreationGuest[]
    createdAt                 DateTime                    @default(now())

    @@map("loyalty_program_configs")
}
model LoyalityLevel{
    id          String   @id @default(uuid())
    level      Int      @map("level")
    discountPercentage Float @map("discount_percentage")
    noOfReservations Int @default(1) @map("no_of_reservations")
    propertyLoyaltyConfigId String                @map("property_loyalty_config_id")
    PropertyLoyaltyConfig   PropertyLoyaltyConfig @relation(fields: [propertyLoyaltyConfigId], references: [id], onDelete: Cascade)

    @@unique([propertyLoyaltyConfigId, level])

    @@map("loyalty_levels")
}

model LoyalityGuest {
    id String @id @default(uuid())

    guestEmail String  @unique @map("guest_email")
    guestId    String? @map("guest_id")
    password   String  @map("password")

    guest         Guests?         @relation(fields: [guestId], references: [id], onDelete: Cascade)
    CreationGuest CreationGuest[]

    createdAt DateTime @default(now())

    @@map("loyality_guests")
}

model CreationGuest {
    id              String @id @default(uuid())
    loyalityGuestId String @map("loyality_guest_id")
    propertyId      String @map("property_id")
    propertyCode    String @map("property_code")
    metaData        Json   @map("meta_data")
    guestLevel      Int    @default(1) @map("guest_level")

    Property                Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    LoyalityGuest           LoyalityGuest         @relation(fields: [loyalityGuestId], references: [id], onDelete: Cascade)
    creationLoyaltyConfigId String                @map("creation_loyalty_config_id")
    CreationLoyaltyConfig   CreationLoyaltyConfig @relation(fields: [creationLoyaltyConfigId], references: [id], onDelete: Cascade)

    @@unique([propertyId, loyalityGuestId])
    @@map("creation_guests")
}
model PropertyLoyaltyConfig {
    id                 String  @id @default(uuid())
    propertyId         String  @unique @map("property_id")
    propertyCode       String  @unique @map("property_code")
    propertyName       String  @map("property_name")
    Property           Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    discountPercentage Int?    @map("discount_percentage")
    loyalityConfigLogo String? @map("loyality_config_logo")
    loyalityLevels     LoyalityLevel[]
    isActive           Boolean @default(true) @map("is_active")

    @@map("property_loyalty_configs")
}