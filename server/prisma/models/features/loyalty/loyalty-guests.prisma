model LoyalityGuest {
  id                     String                   @id @default(uuid())
  guestEmail             String                   @unique @map("guest_email")
  guestId                String?                  @map("guest_id")
  password               String                   @default(" ") @map("password")
  otaGuestId             String?                  @unique @map("ota_guest_id")
  createdAt              DateTime                 @default(now())
  CreationGuest          CreationGuest[]
  guest                  Guests?                  @relation(fields: [guestId], references: [id], onDelete: Cascade)
  OtaGuest               OtaGuest?                @relation(fields: [otaGuestId], references: [id], onDelete: Cascade)
  PropertyLoyalityGuests PropertyLoyalityGuests[]

  @@map("loyality_guests")
}

model CreationGuest {
  id                      String                @id @default(uuid())
  loyalityGuestId         String                @map("loyality_guest_id")
  metaData                Json                  @map("meta_data")
  guestLevel              Int                   @default(1) @map("guest_level")
  creationLoyaltyConfigId String                @map("creation_loyalty_config_id")
  noOfBookings            Int                   @default(0) @map("no_of_bookings")
  CreationLoyaltyConfig   CreationLoyaltyConfig @relation(fields: [creationLoyaltyConfigId], references: [id], onDelete: Cascade)
  LoyalityGuest           LoyalityGuest         @relation(fields: [loyalityGuestId], references: [id], onDelete: Cascade)

  @@unique([creationLoyaltyConfigId, loyalityGuestId])
  @@map("creation_guests")
}
