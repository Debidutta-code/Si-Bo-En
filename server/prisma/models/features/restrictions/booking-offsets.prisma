model BookingOffset {
  id                          String   @id @default(uuid())
  propertyId                  String   @map("property_id")
  ratePlanCode                String   @map("rate_plan_code")
  ratePlanId                  String   @map("rate_plan_id")
  ratePlanName                String   @map("rate_plan_name")
  minimumAdvanceBookingOffset Int?     @map("minimum_advance_booking_offset")
  maximumAdvanceBookingOffset Int?     @map("maximum_advance_booking_offset")
  minimumAmendBookingOffset   Int?     @map("minimum_amend_booking_offset")
  maximumAmendBookingOffset   Int?     @map("maximum_amend_booking_offset")
  minimumCancelBookingOffset  Int?     @map("minimum_cancel_booking_offset")
  maximumCancelBookingOffset  Int?     @map("maximum_cancel_booking_offset")
  isActive                    Boolean  @default(true) @map("is_active")
  date                        DateTime @db.Date
  createdAt                   DateTime @default(now())
  property                    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  ratePlan                    RatePlan @relation(fields: [ratePlanCode], references: [ratePlanCode], onDelete: Cascade)

  @@unique([ratePlanId, date])
  @@map("booking_offsets")
}
