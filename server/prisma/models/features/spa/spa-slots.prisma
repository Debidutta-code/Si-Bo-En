model SpaDates {
    id          String     @id @default(uuid())
    date        DateTime   @map("date")
    spaModuleId String     @map("spa_module_id")
    spaModule   Spa        @relation(fields: [spaModuleId], references: [id])
    Slots       SpaSlots[]

    @@unique([spaModuleId, date])
    @@map("spa_dates")
}

model SpaSlots {
    id        String   @id @default(uuid())
    startTime DateTime @map("start_time")
    endTime   DateTime? @map("end_time")
    spaDateId String   @map("spa_date_id")
    isBooked  Boolean  @map("is_booked")

    spaDate SpaDates @relation(fields: [spaDateId], references: [id])

    @@map("spa_slots")
}
