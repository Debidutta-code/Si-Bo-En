model SpaDates {
  id   String   @id @default(uuid())
  date DateTime @map("date")

  spaModuleId String @map("spa_module_id")
  spaModule   Spa    @relation(fields: [spaModuleId], references: [id], onDelete: Cascade)

  slots SpaSlots[]

  @@unique([spaModuleId, date])
  @@index([spaModuleId])
  @@index([date])
  @@map("spa_dates")
}

model SpaSlots {
  id        String    @id @default(uuid())
  startTime DateTime  @map("start_time")
  endTime   DateTime? @map("end_time")
  isActive  Boolean   @default(true) @map("is_active")
  spaDateId String   @map("spa_date_id")
  spaDate   SpaDates @relation(fields: [spaDateId], references: [id], onDelete: Cascade)

  spaPricing     SpaPricing?
  slotsAvailable SlotsAvailable[]

  @@index([spaDateId])
  @@map("spa_slots")
}

model SlotsAvailable {
  id String @id @default(uuid())

  spaSlotId String   @map("spa_slot_id")
  spaSlot   SpaSlots @relation(fields: [spaSlotId], references: [id], onDelete: Cascade)

  status SlotStatus @default(active) @map("status")
   userName      String?       @map("user_name")

  reservationId String?      @map("reservation_id")
  reservation   Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  slotBooking SlotBooking?

 
  @@map("slots_available")
}
