model UserAssignedSpa {
    id     String @id @default(uuid())
    userId String @map("user_id")
    spaId  String @map("spa_id")
    User   User   @relation("UserAssignedSpa", fields: [userId], references: [id])
    Spa    Spa    @relation("SpaToUserAssignedSpa", fields: [spaId], references: [id])

    @@map("user_assigned_spa")
}