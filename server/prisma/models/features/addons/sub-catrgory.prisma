model AddonSubCategory {
    id         String         @id @default(uuid())
    code       String         @unique
    name       String
    categoryId String
    category   AddonCategory  @relation(fields: [categoryId], references: [id])
    addons     Addon[]
    variants   AddonVariant[]
    createdAt  DateTime       @default(now())
    updatedAt  DateTime       @updatedAt
}