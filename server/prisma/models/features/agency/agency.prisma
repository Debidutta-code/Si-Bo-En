model Agency {
  id                 String              @id @default(uuid())
  agencyName         String              @unique @map("agency_name")
  agencyType         AgencyType          @default(travel_agency) @map("agency_type")
  agencyEmail        String              @unique @map("agency_email")
  contactNo          String              @map("contact_no")
  taxNo              String              @unique @map("tax_no")
  commissionType     AgentCommissionType @default(percentage) @map("commission_type")
  commissionValue    Int                 @map("commission_value")
  commissionCurrency CurrencyCode?       @default(INR) @map("commission_currency")
  iataCode           String              @map("iata_code")
  address            String              @map("address")
  isDeleted          Boolean             @default(false) @map("is_deleted")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  AgencyCommissions  AgencyCommission[]
  AgenticProperties  AgenticProperty[]
  Agents             Agents[]
  Reservations       Reservation[]

  @@map("agency")
}

model AgencyCommission {
  id               String              @id @default(uuid())
  reservationId    String              @unique @map("reservation_id")
  agencyId         String              @map("agency_id")
  agentId          String?             @map("agent_id")
  commissionType   AgentCommissionType @map("commission_type")
  commissionValue  Float               @map("commission_value")
  commissionAmount Float               @map("commission_amount")
  currencyCode     CurrencyCode        @map("currency_code")
  createdAt        DateTime            @default(now()) @map("created_at")
  agency           Agency              @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agent            Agents?             @relation(fields: [agentId], references: [id])
  reservation      Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@index([agentId])
  @@map("agency_commissions")
}
