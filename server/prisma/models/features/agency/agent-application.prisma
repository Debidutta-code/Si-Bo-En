model AgentApplications {
    id                       String                  @id @default(uuid())
    applicationNoForThisUser Int                     @map("application_no_for_this_user")
    status                   AgencyApplicationStatus @default(pending) @map("status")
    rejectionReason          String?                 @map("rejection_reason")

    applicantEmail     String              @unique @map("applicant_email")
    applicantName      String              @map("applicant_name")
    applicantPhone     String              @map("applicant_phone")
    applicantPassword  String              @map("applicant_password")
    //agency application details
    agencyName         String              @unique @map("agency_name")
    agencyType         AgencyType          @default(travel_agency) @map("agency_type")
    agencyEmail        String              @unique @map("agency_email")
    contactNo          String              @map("contact_no")
    taxNo              String              @unique @map("tax_no")
    commissionType     AgentCommissionType @default(percentage) @map("commission_type")
    commissionValue    Int                 @map("commission_value")
    commissionCurrency CurrencyCode?       @default(INR) @map("commission_currency")
    iataCode           String              @map("iata_code")
    address            String              @map("address")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("agent_applications")
}