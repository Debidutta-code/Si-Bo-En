model Review{
  id String @id @default(uuid()) @map("id")

  propertyId String @map("property_id")
  propertyCode String @map("property_code")
  propertyName String @map("property_name")

  otaCustomerId String @map("ota_customer_id")

  rating Float @map("rating")
  review String @map("review")
  isDeleted Boolean @default(false) @map("is_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  OtaGuest OtaGuest @relation(fields: [otaCustomerId], references: [id])
  Property Property @relation(fields: [propertyId], references: [id])

  @@map("customer_reviews")
}