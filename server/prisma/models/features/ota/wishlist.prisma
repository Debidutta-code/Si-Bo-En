model WishList {
  id String @id @default(uuid()) @map("id")

  customerId   String @map("customer_id")
  propertyId   String @map("property_id")
  propertyCode String @map("property_code")
  propertyName String @map("property_name")

  createdAt DateTime @default(now()) @map("created_at")

  Customer     Customers      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Property     Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  RoomWishList RoomWishList[]

  @@unique([customerId, propertyId])
  @@map("customer_wishlist")
}

model RoomWishList {
  id         String   @id @default(uuid())
  wishlistId String   @map("wishlist_id")
  roomId     String   @map("room_id")
  roomType   String   @map("room_type")
  roomName   String   @map("room_name")
  createdAt  DateTime @default(now()) @map("created_at")

  WishList WishList @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  Room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, roomId])
  @@map("room_wishlist")
}
