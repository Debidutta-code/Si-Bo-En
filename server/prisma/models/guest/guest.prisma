model Guests {
  id                   String                @id @default(uuid())
  firstName            String                @map("first_name")
  lastName             String                @map("last_name")
  email                String?
  phoneNumber          String?               @map("phone_number")
  userType             GuestType             @default(adult) @map("user_type")
  propertyId           String                @map("property_id")
  address              String?
  city                 String?
  state                String?
  country              String?
  zipCode              String?               @map("zip_code")
  userIdentityCardType userIdentityCardType? @default(adhar_card) @map("user_identity_card")
  identityCardNumber   String?               @map("identity_card_number")
  identityCardImage    String?               @map("identity_card_image")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isALoyalityGuest     Boolean               @default(false) @map("is_a_loyality_guest")
  property             Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  loyalityGuests       LoyalityGuest[]
  ProblemTickets       ProblemTickets[]      @relation("TicketCreatedBy")
  primaryReservations  Reservation[]         @relation("ReservationPrimaryGuest")

  @@unique([propertyId, email])
  @@map("guests")
}
