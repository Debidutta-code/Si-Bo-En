model Inventory {
    id           String   @id @default(uuid())
    propertyCode String   @map("property_code")
    roomTypeCode String   @map("room_type_code")
    date         DateTime @db.Date
    availability Int
    ratePlans    String[] @map("rate_plans")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([propertyCode])
    @@index([roomTypeCode])
    @@map("inventories")
}