    promotionName      String        @map("promotion_name")
    propertyId         String        @map("property_id")
    validFrom          DateTime?     @map("valid_from")
    validTo            DateTime?     @map("valid_to")
    advanceBookingDays Int?          @default(0) @map("advance_booking_days")
    promotionType      PromotionType @map("promotion_type")
    roomId             String?       @map("room_id")
    roomType           String?       @map("room_type")
    deviceType         DeviceType[]  @default([]) @map("device_type")
    ratePlanId         String        @map("rate_plan_id")
    ratePlanCode       String        @map("rate_plan_code")
    discountType       DiscountType  @default(percentage) @map("discount_type")
    discountValue      Float?        @map("discount_value")
    currencyCode       CurrencyCode? @default(AED) @map("currency_code")
    monApplicable      Boolean       @default(true) @map("mon_applicable")
    tueApplicable      Boolean       @default(true) @map("tue_applicable")
    wedApplicable      Boolean       @default(true) @map("wed_applicable")
    thuApplicable      Boolean       @default(true) @map("thu_applicable")
    friApplicable      Boolean       @default(true) @map("fri_applicable")
    satApplicable      Boolean       @default(true) @map("sat_applicable")
    sunApplicable      Boolean       @default(true) @map("sun_applicable")
    isActive           Boolean       @default(true) @map("is_active")

    isAutoApplied         Boolean                @default(false) @map("is_auto_applied")
    createdAt             DateTime               @default(now()) @map("created_at")
    property              Property               @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    room                  Room?                  @relation(fields: [roomId], references: [id], onDelete: Cascade)
    ratePlan              RatePlan               @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
    reservationPromotions ReservationPromotion[]

    @@index([propertyId, roomId, ratePlanId])
    @@map("promotion_rule")
}

model LoyalityGuest {
    id                      String                @id @default(uuid())
    creationLoyaltyConfigId String                @map("creation_loyalty_config_id")
    CreationLoyaltyConfig   CreationLoyaltyConfig @relation(fields: [creationLoyaltyConfigId], references: [id], onDelete: Cascade)

    propertyId   String   @map("property_id")
    property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    propertyCode String   @map("property_code")
    guestEmail   String   @map("guest_email")
    guestId      String?  @map("guest_id")
    guest        Guests?  @relation(fields: [guestId], references: [id], onDelete: Cascade)
    metaData     Json     @map("meta_data")
    createdAt    DateTime @default(now())

    @@unique([propertyId, guestEmail])
    @@map("loyality_guests")
}

model CustomizableDeal {
    id String @id @default(uuid())

    propertyId   String @map("property_id")
    propertyCode String @map("property_code")

    discountType  DiscountType  @default(percentage) @map("discount_type")
    discountValue Float         @map("discount_value")
    currencyCode  CurrencyCode? @default(AED) @map("currency_code")
    startDate     DateTime      @map("start_date") @db.Date
    endDate       DateTime      @map("end_date") @db.Date
    isActive      Boolean       @default(true) @map("is_active")
    isAutoApplied Boolean       @default(false) @map("is_auto_applied")
    roomType      String        @map("room_type")
    roomId        String        @map("room_id")
    ratePlanId    String        @map("rate_plan_id")
    ratePlanCode  String        @map("rate_plan_code")
    createdAt     DateTime      @default(now()) @map("created_at")

    Property                          Property                            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    Room                              Room                                @relation(fields: [roomId], references: [id], onDelete: Cascade)
    RatePlan                          RatePlan                            @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
    CustomizableDealsApplicableAddons CustomizableDealsApplicableAddons[]

    @@map("customizable_deals")
}

model CustomizableDealsApplicableAddons {
    id String @id @default(uuid())

    customizableDealId String @map("customizable_deal_id")
    addOnId            String @map("add_on_id")

    createdAt DateTime @default(now()) @map("created_at")

    CustomizableDeal CustomizableDeal @relation(fields: [customizableDealId], references: [id], onDelete: Cascade)
    AddOn            Addon            @relation(fields: [addOnId], references: [id], onDelete: Cascade)

    @@unique([customizableDealId, addOnId])
    @@map("customizable_deals_applicable_addons")
}

model TouristTaxes {
    id String @id @default(uuid())

    name          String? @default("Tourist Tax") //remove this ? when there is a need for db push
    ratePlanId    String  @unique @map("rate_plan_id")
    ratePlanCode  String  @unique @map("rate_plan_code")
    discountValue Float?  @map("discount_value")

    createdAt DateTime @default(now()) @map("created_at")

    discountType DiscountType  @default(flat) @map("discount_type")
    ratePlan     RatePlan      @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
    currencyCode CurrencyCode? @default(AED) @map("currency_code")

    @@map("tourist_taxes")
}

model MasterPaymentIntegration {
    id                          String                       @id @default(uuid())
    name                        String                       @unique
    isActive                    Boolean                      @default(true) @map("is_active")
    propertyPaymentIntegrations PropertyPaymentIntegration[]

    @@map("master_payment_integrations")
}

model PropertyPaymentIntegration {
    id                   String  @id @default(uuid())
    propertyId           String  @map("property_id")
    paymentIntegrationId String  @map("payment_integration_id")
    isActive             Boolean @default(false) @map("is_active")
    outletId             String  @map("outlet_id")

    property           Property                 @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    paymentIntegration MasterPaymentIntegration @relation(fields: [paymentIntegrationId], references: [id])
    payments           Payment[]

    @@unique([id, outletId])
    @@unique([propertyId, paymentIntegrationId])
    @@map("property_payment_integrations")
}

model Payment {
    id                           String        @id @default(uuid())
    amount                       Float         @map("amount")
    currency                     CurrencyCode  @default(AED) @map("currency")
    status                       PaymentStatus @default(pending) @map("status")
    paymentMethod                PaymentMethod @default(pay_at_hotel) @map("payment_method")
    propertyPaymentIntegrationId String?
    paymentIntentId              String?       @map("payment_intent_id")

    propertyId    String  @map("property_id")
    reservationId String? @map("reservation_id")

    Property                   Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    Reservation                Reservation?                @relation(fields: [reservationId], references: [id])
    createdAt                  DateTime                    @default(now()) @map("created_at")
    PropertyPaymentIntegration PropertyPaymentIntegration? @relation(fields: [propertyPaymentIntegrationId], references: [id])

    @@map("payments")
}

model MasterIntegrations {
    id       String           @id @default(uuid())
    type     IntegrationTypes @default(channel_manager)
    name     String
    isActive Boolean          @default(true)

    createdAt                          DateTime                          @default(now()) @map("created_at")
    propertyIntegrations               PropertyIntegrations[]
    requiredFieldsForMasterIntegration MasterIntegrationRequiredFields[]
    masterIntegrationURLFields         MasterIntegrationURLFields[]

    @@unique([name, type])
    @@map("master_integrations")
}

model MasterIntegrationRequiredFields {
    id                  String @id @default(uuid())
    name                String
    masterIntegrationId String @map("master_integration_id")

    MasterIntegration          MasterIntegrations           @relation(fields: [masterIntegrationId], references: [id], onDelete: Cascade)
    propertyInregrationSecrets PropertyInregrationSecrets[]

    @@unique([masterIntegrationId, name])
    @@index([masterIntegrationId])
    @@map("required_fields_for_master_integration")
}

model MasterIntegrationURLFields {
    id                  String @id @default(uuid())
    name                String
    url                 String
    masterIntegrationId String @map("master_integration_id")

    MasterIntegration MasterIntegrations @relation(fields: [masterIntegrationId], references: [id], onDelete: Cascade)

    @@index([masterIntegrationId])
    @@map("master_integration_url_fields")
}

model PropertyIntegrations {
    id                         String                       @id @default(uuid())
    propertyId                 String                       @map("property_id")
    Property                   Property                     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    masterIntegrationId        String                       @map("master_integration_id")
    MasterIntegration          MasterIntegrations           @relation(fields: [masterIntegrationId], references: [id])
    isActive                   Boolean                      @map("is_active")
    propertyIntegrationSecrets PropertyInregrationSecrets[]

    createdAt DateTime @default(now()) @map("created_at")

    @@unique([propertyId, masterIntegrationId])
    @@index([propertyId])
    @@index([masterIntegrationId])
    @@map("property_integrations")
}

model PropertyInregrationSecrets {
    id                    String                          @id @default(uuid())
    propertyIntegrationId String                          @map("property_integration_id")
    requiredFieldId       String                          @map("required_field_id")
    value                 String
    PropertyIntegration   PropertyIntegrations            @relation(fields: [propertyIntegrationId], references: [id], onDelete: Cascade)
    RequiredField         MasterIntegrationRequiredFields @relation(fields: [requiredFieldId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now()) @map("created_at")

    @@unique([propertyIntegrationId, requiredFieldId])
    @@index([propertyIntegrationId])
    @@index([requiredFieldId])
    @@map("property_integration_secrets")
}
