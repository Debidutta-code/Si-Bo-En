model PropertyCommission {
    id         String   @id @default(uuid())
    propertyId String   @unique @map("property_id")
    property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    commissionType  commissionType @default(percentage) @map("commission_type")
    commissionValue Float          @map("commission_value")
    currencyCode    CurrencyCode?  @default(INR) @map("currency_code")

    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@map("property_commission")
}

enum CommissionOrDiscount {
    commission
    tax
}

model Agency {
    id                 String              @id @default(uuid())
    agencyName         String              @unique @map("agency_name")
    agencyType         AgencyType          @default(travel_agency) @map("agency_type")
    agencyEmail        String              @unique @map("agency_email")
    contactNo          String              @map("contact_no")
    taxNo              String              @unique @map("tax_no")
    commissionType     AgentCommissionType @default(percentage) @map("commission_type")
    commissionValue    Int                 @map("commission_value")
    commissionCurrency CurrencyCode?       @default(INR) @map("commission_currency")
    iataCode           String              @map("iata_code")
    address            String              @map("address")

    Agents            Agents[]
    AgenticProperties AgenticProperty[]
    Reservations      Reservation[]
    isDeleted         Boolean           @default(false) @map("is_deleted")
    createdAt         DateTime          @default(now()) @map("created_at")
    updatedAt         DateTime          @updatedAt @map("updated_at")

    @@map("agency")
}

model AgenticProperty {
    id           String        @id @default(uuid())
    agencyId     String        @map("agency_id")
    agency       Agency        @relation(fields: [agencyId], references: [id], onDelete: Cascade)
    propertyId   String        @map("property_id")
    propertyCode String        @map("property_code")
    propertyName String        @map("property_name")
    Property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    AgenticRooms AgenticRoom[]

    isActive  Boolean  @default(true) @map("is_active")
    isDeleted Boolean  @default(false) @map("is_deleted")
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([agencyId, propertyId])
    @@index([agencyId])
    @@index([propertyId])
    @@map("agentic_property")
}

model AgenticRoom {
    id                String          @id @default(uuid())
    agenticPropertyId String          @map("agentic_property_id")
    AgenticProperty   AgenticProperty @relation(fields: [agenticPropertyId], references: [id], onDelete: Cascade)

    roomId   String @map("room_id")
    roomType String @map("room_type")
    roomName String @map("room_name")
    room     Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

    isActive  Boolean  @default(true) @map("is_active")
    isDeleted Boolean  @default(false) @map("is_deleted")
    createdAt DateTime @default(now()) @map("created_at")

    @@unique([agenticPropertyId, roomId])
    @@index([agenticPropertyId])
    @@index([roomId])
    @@map("agentic_room")
}

model Agents {
    id       String @id @default(uuid())
