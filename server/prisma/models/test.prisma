
//Add Ons
model AddonCategory {
    id        String   @id @default(uuid())
    code      String   @unique
    name      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    subcategories AddonSubCategory[]
    addons        Addon[]
}

model AddonSubCategory {
    id         String         @id @default(uuid())
    code       String         @unique
    name       String
    categoryId String
    category   AddonCategory  @relation(fields: [categoryId], references: [id])
    addons     Addon[]
    variants   AddonVariant[]
    createdAt  DateTime       @default(now())
    updatedAt  DateTime       @updatedAt
}

model AddonVariant {
    id            String           @id @default(uuid())
    code          String           @unique
    name          String
    subcategoryId String
    subCategory   AddonSubCategory @relation(fields: [subcategoryId], references: [id])
    addons        Addon[]          @relation("AddonToVariant")
    createdAt     DateTime         @default(now())
    updatedAt     DateTime         @updatedAt
}

model Addon {
    id                                String                              @id @default(uuid())
    propertyId                        String
    categoryId                        String?
    subcategoryId                     String?
    variantId                         String?
    ratePlanId                        String?                             @map("rate_plan_id")
    code                              String                              @unique
    name                              String
    postingRhythm                     PostingRhythm                       @default(per_stay)
    description                       String?
    isActive                          Boolean                             @default(true)
    images                            String[]
    createdAt                         DateTime                            @default(now())
    updatedAt                         DateTime                            @updatedAt
    property                          Property                            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    subCategory                       AddonSubCategory?                   @relation(fields: [subcategoryId], references: [id])
    category                          AddonCategory?                      @relation(fields: [categoryId], references: [id])
    addonVariant                      AddonVariant?                       @relation("AddonToVariant", fields: [variantId], references: [id])
    bookingAddons                     BookingAddon[]
    availability                      AddonAvailability[]
    ratePlans                         RatePlanWithAddon[]
    customizableDealsApplicableAddons CustomizableDealsApplicableAddons[]
    ChildAddons                       ChildAddon[]
}

model ChildAddon {
    id                 String        @id @default(uuid())
    addonId            String
    Addon              Addon         @relation(fields: [addonId], references: [id], onDelete: Cascade)
    minAge             Int           @map("min_age")
    maxAge             Int           @map("max_age")
    discountApplicable Boolean       @default(false) @map("discount_applicable")
    discountType       DiscountType? @default(percentage) @map("discount_type")
    discountAmount     Float?        @default(0) @map("discount_amount")
    currencyCode       CurrencyCode? @default(INR) @map("currency_code")
}

model RatePlanWithAddon {
    id         String   @id @default(uuid())
    ratePlanId String   @map("rate_plan_id")
    addonId    String   @map("addon_id")
    ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
    addon      Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)
    createdAt  DateTime @default(now()) @map("created_at")

    @@unique([ratePlanId, addonId])
    @@map("rate_plan_with_addon")
}

model BookingAddon {
    id                  String               @id @default(uuid())
    reservationId       String
    addonId             String
    name                String
    unitPrice           Float
    quantity            Int
    totalPrice          Float
    currencyCode        String               @default("INR")
    specialInstructions String?
    date                DateTime             @default(now())
    type                ReservationAddonType @default(included)

    Reservation Reservation @relation(fields: [reservationId], references: [id])

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    addon Addon @relation(fields: [addonId], references: [id])
}

model AddonAvailability {
    id           String   @id @default(uuid())
    addonId      String
    // propertyId   String
    date         DateTime @db.Date
    price        Float
    currencyCode String   @default("INR") @db.VarChar(5)
    isAvailable  Boolean  @default(true)
    createdAt    DateTime @default(now())
    updatedAt    DateTime @updatedAt
    addon        Addon    @relation(fields: [addonId], references: [id], onDelete: Cascade)

    @@unique([addonId, date])
}

model Reservation {
    id String @id @default(uuid()) @map("id") @db.VarChar(36)

    // Property & Room
    propertyId   String  @map("property_id") @db.VarChar(36)
    propertyCode String? @map("property_code") @db.VarChar(50)
    hotelName    String? @map("hotel_name") @db.VarChar(150)

    roomTypeCode String? @map("room_type_code") @db.VarChar(50)
    ratePlanCode String? @map("rate_plan_code") @db.VarChar(50)

    bookingCode String @unique @map("booking_code") @db.VarChar(50)

    // Dates
    bookedAt DateTime @default(now()) @map("booked_at")

    checkInDate    DateTime   @map("check_in_date") @db.Date
    checkOutDate   DateTime   @map("check_out_date") @db.Date
    countryCode    String     @map("country_code") @db.VarChar(5)
    timezone       String     @map("timezone") @db.VarChar(50)
    deviceTypes    DeviceType @map("device_types")
    // Primary Guest Relation (one-to-many: one guest can have multiple reservations)
    primaryGuestId String     @map("primary_guest_id") @db.VarChar(36)
    primaryGuest   Guests     @relation("ReservationPrimaryGuest", fields: [primaryGuestId], references: [id])

    // Guest Data
    guests           Json    @map("guests")
    bookingUserEmail String  @map("booking_user_email") @db.VarChar(150)
    bookingUserPhone String? @map("booking_user_phone") @db.VarChar(50)

    // Pricing
    amount       Float        @map("amount")
    currencyCode CurrencyCode @default(INR) @map("currency_code")
    finalPrice   Json?        @map("final_price")

    paidAmount       Float @default(0) @map("paid_amount")
    extraAmountToPay Float @default(0) @map("extra_amount_to_pay")
    refundAmount     Float @default(0) @map("refund_amount")

    // Payment
    paymentMethod PaymentMethod @default(pay_at_hotel) @map("payment_method")
    paymentImages Json?         @map("payment_images")

    // Booking Status
    bookingStatus      BookingStatus @default(confirmed) @map("booking_status")
    cancellationReason String?       @map("cancellation_reason") @db.VarChar(255)

    // Booking Source
    bookingSource BookingSource @default(direct) @map("source")

    // Promo
    isPromoUsed      Boolean   @default(false) @map("is_promo_used")
    promoId          String?   @map("promo_id") @db.VarChar(36)
    //store this in utc
    actualCheckInAt  DateTime? @map("actual_check_in_at")
    actualCheckOutAt DateTime? @map("actual_check_out_at")
    cancelledAt      DateTime? @map("cancelled_at")
    agencyId         String?   @map("agency_id") @db.VarChar(36)

    // Audit
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    // Relations

    property              Property                    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    promo                 PromoCode?                  @relation(fields: [promoId], references: [id])
    addOns                BookingAddon[]
    priceBreakdowns       ReservationPriceBrakeDown[]
    agency                Agency?                     @relation(fields: [agencyId], references: [id])
    reservationPromotions ReservationPromotion[]
    payments              Payment[]
    reservationGuests     ReservationGuest[]

    @@index([propertyCode])
    @@index([propertyId])
    @@index([roomTypeCode])
    @@index([ratePlanCode])
    @@index([bookingStatus])
    @@index([bookingSource])
    @@index([primaryGuestId])
    @@map("reservations")
}

model ReservationGuest {
    id            String      @id @default(uuid())
    reservationId String      @map("reservation_id")
    reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

    firstName   String    @map("first_name")
    lastName    String    @map("last_name")
    type        GuestType @default(adult) @map("type")
    dateOfBirth DateTime? @map("date_of_birth")
    age         Int?      @map("age")
    createdAt   DateTime  @default(now()) @map("created_at")

    @@index([reservationId])
    @@map("reservation_guests")
}

enum ReservationPromotionType {
    early_bird
    mlos
    device_specific
    offer_for_tonight
    normal
}

model ReservationPromotion {
    id            String                   @id @default(uuid())
    bookingCode   String                   @map("booking_code")
    bookingId     String                   @map("booking_id")
    Reservation   Reservation              @relation(fields: [bookingId], references: [id])
    promotionType ReservationPromotionType @default(mlos) @map("promotion_type")
    promotionId   String?                  @map("promotion_id")
    mlosId        String?                  @map("mlos_id")
    Promotion     Promotion?               @relation(fields: [promotionId], references: [id])
    RatePlanRule  RatePlanRule?            @relation(fields: [mlosId], references: [id])
    amount        Float                    @map("amount")
    currency      CurrencyCode             @default(AED) @map("currency")

    @@map("reservation_promotions")
}

model Guests {
    id                   String                @id @default(uuid())
    firstName            String                @map("first_name")
    lastName             String                @map("last_name")
    email                String?
    phoneNumber          String?               @map("phone_number")
    primaryReservations  Reservation[]         @relation("ReservationPrimaryGuest")
    userType             GuestType             @default(adult) @map("user_type")
    propertyId           String                @map("property_id")
    property             Property              @relation(fields: [propertyId], references: [id], onDelete: Cascade)
    address              String?
    city                 String?
    state                String?
    country              String?
    zipCode              String?               @map("zip_code")
    userIdentityCardType userIdentityCardType? @default(adhar_card) @map("user_identity_card")
    identityCardNumber   String?               @map("identity_card_number")
    identityCardImage    String?               @map("identity_card_image")
    loyalityGuests       LoyalityGuest[]
    createdAt            DateTime              @default(now())
    updatedAt            DateTime              @updatedAt
    isALoyalityGuest     Boolean               @default(false) @map("is_a_loyality_guest")

    @@unique([propertyId, email])
    @@map("guests")
}

model ReservationPriceBrakeDown {
    id                     String      @id @default(uuid())
    reservationId          String      @map("reservation_id")
    Reservation            Reservation @relation(fields: [reservationId], references: [id])
    additionalGuestCharges Int         @default(0) @map("additional_guest_charges")
    baseRatePerNight       Int         @default(0) @map("base_rate_per_night")
    numberOfNights         Int         @default(0) @map("number_of_nights")
    priceAfterTax          Float       @default(0) @map("price_after_tax")
    totalAmount            Float       @default(0) @map("total_amount")
    totalTax               Float       @default(0) @map("total_tax")
    breakdown              Json        @map("brake_down")
    dailyBreakdown         Json[]      @map("daily_breakdown")
    createdAt              DateTime    @default(now())
    availableRooms         Int         @default(0) @map("available_rooms")
    requestedRooms         Int         @default(0) @map("requested_rooms")
    tax                    Json[]

    @@map("reservation_price_brake_down")
}

model RoomVideo {
    id        String   @id @default(uuid())
    roomId    String   @unique
    url       String
    thumbnail String?
    createdAt DateTime @default(now())

    room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

    @@map("room_videos")
}

model PropertyVideo {
    id         String   @id @default(uuid())
    propertyId String   @unique
    url        String
    thumbnail  String?
    createdAt  DateTime @default(now())

    property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

    @@map("property_videos")
}

model RatePlanRule {
    id String @id @default(uuid())

    ratePlanId String   @unique @map("rate_plan_id")
    ratePlan   RatePlan @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)

    startDate DateTime? @map("start_date")
    endDate   DateTime? @map("end_date")

    minLos               Int                    @default(0) @map("min_los")
    maxLos               Int?                   @map("max_los")
    isAutoApplied        Boolean                @default(false) @map("is_auto_applied")
    discountType         DiscountType?          @map("discount_type")
    currencyCode         CurrencyCode           @default(AED) @map("currency_code")
    discountValue        Float?                 @map("discount_value")
    ReservationPromotion ReservationPromotion[]

    isActive Boolean @default(true)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("rate_plan_rules")
