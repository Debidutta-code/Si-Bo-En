model Creation {
  id                   String                 @id @default(uuid())
  type                 CreationType
  name                 String
  images               String[]
  superId              String?                @map("super_id")
  groupId              String?                @map("group_id")
  brandId              String?                @map("brand_id")
  regionalId           String?                @map("regional_id")
  propertyId           String?                @unique @map("property_id")
  createdById          String                 @map("created_by_id")
  isActive             Boolean                @default(true) @map("is_active")
  isDeleted            Boolean                @default(false) @map("is_deleted")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  brand                Creation?              @relation("BrandRelation", fields: [brandId], references: [id], onDelete: Cascade)
  brandChildren        Creation[]             @relation("BrandRelation")
  createdBy            User                   @relation("CreationCreatedBy", fields: [createdById], references: [id])
  group                Creation?              @relation("GroupRelation", fields: [groupId], references: [id], onDelete: Cascade)
  groupChildren        Creation[]             @relation("GroupRelation")
  regional             Creation?              @relation("RegionalRelation", fields: [regionalId], references: [id], onDelete: Cascade)
  regionalChildren     Creation[]             @relation("RegionalRelation")
  super                Creation?              @relation("SuperRelation", fields: [superId], references: [id])
  superChildren        Creation[]             @relation("SuperRelation")
  loyaltyProgramConfig CreationLoyaltyConfig?
  property             Property?
  users                User[]                 @relation("UserCreation")
  level0Users          User[]                 @relation("Level0Users")
  level1Users          User[]                 @relation("Level1Users")
  level2Users          User[]                 @relation("Level2Users")
  level3Users          User[]                 @relation("Level3Users")
  level4Users          User[]                 @relation("Level4Users")

  @@index([type])
  @@index([createdById])
  @@index([superId])
  @@index([groupId])
  @@index([brandId])
  @@index([propertyId])
  @@map("creations")
}
