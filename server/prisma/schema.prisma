model Reservation {
  id                 String   @id @default(uuid()) @db.VarChar(36) @map("id")

  // Property & Room
  propertyId         String   @db.VarChar(36) @map("property_id")
  propertyCode       String?  @db.VarChar(50) @map("property_code")
  hotelName          String?  @db.VarChar(150) @map("hotel_name")

  roomTypeCode       String?  @db.VarChar(50) @map("room_type_code")
  ratePlanCode       String?  @db.VarChar(50) @map("rate_plan_code")

  // Booking Identity
  bookingCode        String   @unique @db.VarChar(50) @map("booking_code")

  // Dates
  bookedAt           DateTime @default(now()) @map("booked_at")
  checkInDate        DateTime @map("check_in_date")
  checkOutDate       DateTime @map("check_out_date")
  // Primary Guest Relation (one-to-many: one guest can have multiple reservations)
  primaryGuestId     String   @db.VarChar(36) @map("primary_guest_id")
  primaryGuest       Guests   @relation("ReservationPrimaryGuest", fields: [primaryGuestId], references: [id])
  
  // Guest Data
  guests             Json     @map("guests")
  bookingUserEmail   String   @db.VarChar(150) @map("booking_user_email")
  bookingUserPhone   String?  @db.VarChar(50) @map("booking_user_phone")

  // Pricing
  amount             Float    @map("amount")
  currencyCode       CurrencyCode @default(INR) @map("currency_code")
  finalPrice         Json?    @map("final_price")

  paidAmount         Float    @default(0) @map("paid_amount")
  extraAmountToPay   Float    @default(0) @map("extra_amount_to_pay")
  refundAmount       Float    @default(0) @map("refund_amount")

  // Payment
  paymentMethod      PaymentMethod @default(pay_at_hotel) @map("payment_method")
  paymentImages      Json?    @map("payment_images")

  // Booking Status
  bookingStatus      BookingStatus @default(confirmed) @map("booking_status")
  cancellationReason String?  @db.VarChar(255) @map("cancellation_reason")

  // Booking Source
  bookingSource      BookingSource @default(ota) @map("source")

  // Promo
  isPromoUsed        Boolean  @default(false) @map("is_promo_used")
  promoId            String?  @db.VarChar(36) @map("promo_id")

  // Audit
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  property           Property   @relation(fields: [propertyId], references: [id])
  promo              PromoCode? @relation(fields: [promoId], references: [id])
  addOns             BookingAddon[]
  priceBreakdowns ReservationPriceBrakeDown[]

  @@index([propertyCode])
  @@index([propertyId])
  @@index([roomTypeCode])
  @@index([ratePlanCode])
  @@index([bookingStatus])
  @@index([bookingSource])
  @@index([primaryGuestId])
  @@map("reservations")
}

