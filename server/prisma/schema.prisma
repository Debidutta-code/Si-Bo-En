  // prisma/schema.prisma

  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
  }

  enum Role {
    super_admin
    group_manager
    brand_manager
    hotel_manager
    staff
    revenue_manager
  }
  enum geoRestrictionType {
    percentage
    fixed
    restricted
  }
  enum geoRestrictionTypeAction {
    increase
    decrease
  }
  enum CreationType {
    group
    property
    brand
    super
  }

  enum RoomView {
    city
    sea
    garden
    mountain
    others
  }

  enum RoomUnit {
    sqm
    sqft
  }

  enum SmokingPolicy {
    smoking
    non_smoking
    designated_area
  }

  enum CurrencyCode {
    USD
    EUR
    INR
  }

  enum PaymentStatus {
    confirmed
    cancelled
    pending
  }

  enum PolicyType {
    deposit
    guarantee
    cancellation
  }

  enum DeviceType {
    mobile
    tablet
    desktop
  }

  enum ReservationDeviceType {
    mobile
    tablet
    desktop
  }

  enum DiscountType {
    percentage
    flat
  }

  enum BookingStatus {
    pending
    confirmed
    cancelled
    modified
    no_show
  }

  enum AmenityType {
    room
    property
  }

  enum TaxType {
    percentage
    fixed
  }

  enum commissionType {
    percentage
    fixed
  }

  enum AgencyType {
    travel_agency
    corporate
  }

  enum AgentCommissionType {
    percentage
    fixed
  }

  enum TaxApplicableOn {
    room_rate
    total_amount
  }

  enum AgencyApplicationStatus {
    pending
    approved
    rejected
  }

  enum PostingRhythm {
    per_night
    per_person_per_night
    per_person_per_stay
    per_stay
    per_person_per_room
    per_room
    per_room_per_night
  }

  enum PaymentMethod {
    pay_at_hotel
    net_banking
    upi
    payment_gateway
  }

  enum BookingSource {
    direct
    google
    trip_adviser
    trivago
    social_media
    agency
  }

  enum FolioStatus {
    open
    closed
  }

  enum GuestType {
    adult
    child
    infant
  }

  enum userIdentityCardType {
    passport
    drivers_license
    national_id
    adhar_card
    pan_card
    others
  }

  enum ReservationStatus {
    reserved
    checked_in
    checked_out
    cancelled
    no_show
  }

  model Creation {
    id          String       @id @default(uuid())
    type        CreationType
    name        String
    images      String[]
    // Level users
    level0Users User[]       @relation("Level0Users")
    level1Users User[]       @relation("Level1Users")
    level2Users User[]       @relation("Level2Users")
    level3Users User[]       @relation("Level3Users")
    level4Users User[]       @relation("Level4Users")

    // Fixed self-relations with unique names
    super         Creation?  @relation("SuperRelation", fields: [superId], references: [id])
    superId       String?    @map("super_id")
    superChildren Creation[] @relation("SuperRelation")

    group         Creation?  @relation("GroupRelation", fields: [groupId], references: [id])
    groupId       String?    @map("group_id")
    groupChildren Creation[] @relation("GroupRelation")

    brand         Creation?  @relation("BrandRelation", fields: [brandId], references: [id])
    brandId       String?    @map("brand_id")
    brandChildren Creation[] @relation("BrandRelation")

    // 1:1 relation to Property
    property   Property?
    propertyId String?   @unique @map("property_id")

    // Users that belong to this creation
    users User[] @relation("UserCreation")

    // Creator
    createdBy   User   @relation("CreationCreatedBy", fields: [createdById], references: [id])
    createdById String @map("created_by_id")

    isActive  Boolean  @default(true) @map("is_active")
    isDeleted Boolean  @default(false) @map("is_deleted")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Indexes
    @@index([type])
    @@index([createdById])
    @@index([superId])
    @@index([groupId])
    @@index([brandId])
    @@index([propertyId])
    @@map("creations")
  }

  model User {
    id        String  @id @default(uuid())
    firstName String  @map("first_name")
    lastName  String  @map("last_name")
    email     String  @unique
    password  String
    role      Role    @default(staff)
    userLevel Int     @default(0) @map("user_level")
    isDrafted Boolean @default(false) @map("is_drafted")

    // Relations 1:1
    createdBy   User?   @relation("UserCreatedBy", fields: [createdById], references: [id])
    createdById String? @map("created_by_id")

    creation   Creation? @relation("UserCreation", fields: [creationId], references: [id])
    creationId String?   @map("creation_id")

    // Level-based creation relations
    level0Creation   Creation? @relation("Level0Users", fields: [level0CreationId], references: [id])
    level0CreationId String?   @map("level0_creation_id")

    level1Creation   Creation? @relation("Level1Users", fields: [level1CreationId], references: [id])
    level1CreationId String?   @map("level1_creation_id")

    level2Creation   Creation? @relation("Level2Users", fields: [level2CreationId], references: [id])
    level2CreationId String?   @map("level2_creation_id")

    level3Creation   Creation? @relation("Level3Users", fields: [level3CreationId], references: [id])
    level3CreationId String?   @map("level3_creation_id")

    level4Creation   Creation? @relation("Level4Users", fields: [level4CreationId], references: [id])
    level4CreationId String?   @map("level4_creation_id")

    propertiesCreated Property[] @relation("PropertyCreatedBy")
    usersCreated      User[]     @relation("UserCreatedBy")
    creationsCreated  Creation[] @relation("CreationCreatedBy")
    createdAt         DateTime   @default(now())
    updatedAt         DateTime   @updatedAt
    // RecivedPayments        Payments[]         @relation("PaymentProcessedBy")

    @@index([createdById])
    @@index([creationId])
    @@index([level0CreationId])
    @@index([level1CreationId])
    @@index([level2CreationId])
    @@index([level3CreationId])
    @@index([level4CreationId])
    @@map("users")
  }

  model Property {
    id              String   @id @default(uuid())
    propertyName    String   @map("property_name")
    propertyEmail   String   @map("property_email")
    propertyContact String   @map("property_contact")
    propertyCode    String   @unique @map("property_code")
    description     String
    image           String[]
    starRating      Float?   @map("star_rating")
    isDraft         Boolean  @default(true) @map("is_draft")
    isAvailable     Boolean  @default(true) @map("is_available")
    isDeleted       Boolean  @default(false) @map("is_deleted")

    // Relations
    createdBy   User   @relation("PropertyCreatedBy", fields: [createdById], references: [id])
    createdById String @map("created_by_id")

    creation   Creation @relation(fields: [creationId], references: [id])
    creationId String   @unique @map("creation_id")

    // Embedded Data (1:1 relations)
    propertyCategory  PropertyCategory?
    propertyType      PropertyType?
    propertyAddress   PropertyAddress?
    propertyAmenities PropertyAmenitySelection[]
    bankDetails       BankDetails?
    reservations      Reservation[]
    propertyVideos    PropertyVideo?

    // Children
    propertyRooms       Room[]
    ratePlans           RatePlan[]
    bookingEngineConfig BookingEngineConfigurations?
    promoCodes          PromoCode[]
    taxRules            TaxRule[]                    @relation("PropertyTaxRules")
    taxGroups           TaxGroup[]                   @relation("PropertyTaxGroups")
    addOns              Addon[]
    Guests              Guests[]
    Policy              Policy[]
    propertyConfigs     PropertyConfigs?
    agenticProperties   AgenticProperty[]
    Commissions         PropertyCommission?
    geoRatePlans        GeoRatePlan[]
    createdAt           DateTime                     @default(now())
    updatedAt           DateTime                     @updatedAt

    @@index([createdById])
    @@index([creationId])
    @@index([propertyCode])
    @@map("properties")
  }

  model PropertyConfigs {
    id         String   @id @default(uuid())
    property   Property @relation(fields: [propertyId], references: [id])
    propertyId String   @unique @map("property_id")

    pmsIntegrationActive            Boolean      @default(true) @map("pms_integration_active")
    channelManagerIntegrationActive Boolean      @default(true) @map("channel_manager_integration_active")
    selfAriActive                   Boolean      @default(true) @map("self_ari_active")
    isB2bAvailable                  Boolean      @default(true) @map("is_b2b_available")
    isB2cAvailable                  Boolean      @default(true) @map("is_b2c_available")
    commission                      Boolean      @default(false)
    timezone                        String       @default("Asia/Kolkata") @map("timezone")
    baseCurrency                    CurrencyCode @default(INR) @map("base_currency")
    reservationResetMinutes         Int          @default(570) @map("reservation_reset_minutes")
    createdAt                       DateTime     @default(now())
    updatedAt                       DateTime     @updatedAt

    @@map("property_configs")
  }

  model MasterPropertyCategory {
    id                  String  @id @default(uuid())
    categoryName        String  @unique @map("category_name")
    categoryDescription String? @map("category_description")
    isActive            Boolean @default(true) @map("is_active")

    // Relation to properties that selected this category
    properties PropertyCategory[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("master_property_categories")
  }

  model MasterPropertyType {
    id                      String  @id @default(uuid())
    propertyTypeName        String  @unique @map("property_type_name")
    propertyTypeDescription String? @map("property_type_description")
    isActive                Boolean @default(true) @map("is_active")

    // Relation to properties that selected this type
    properties PropertyType[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("master_property_types")
  }

  model MasterAmenity {
    id          String      @id @default(uuid())
    amenityName String      @unique @map("amenity_name")
    amenityType AmenityType @map("amenity_type") // room or property
    description String?
    icon        String? // for UI display
    isActive    Boolean     @default(true) @map("is_active")

    createdAt                DateTime                   @default(now())
    updatedAt                DateTime                   @updatedAt
    PropertyAmenitySelection PropertyAmenitySelection[]
    RoomAmenitySelection     RoomAmenitySelection[]

    @@map("master_amenities")
  }

  model PropertyCategory {
    id               String                 @id @default(uuid())
    masterCategory   MasterPropertyCategory @relation(fields: [masterCategoryId], references: [id])
    masterCategoryId String                 @map("master_category_id")

    property   Property @relation(fields: [propertyId], references: [id])
    propertyId String   @unique @map("property_id")

    @@map("property_categories")
  }

  model PropertyType {
    id                   String             @id @default(uuid())
    masterPropertyType   MasterPropertyType @relation(fields: [masterPropertyTypeId], references: [id])
    masterPropertyTypeId String             @map("master_property_type_id")

    property   Property @relation(fields: [propertyId], references: [id])
    propertyId String   @unique @map("property_id")

    @@map("property_types")
  }

  model PropertyAmenitySelection {
    id String @id @default(uuid())

    property   Property @relation(fields: [propertyId], references: [id])
    propertyId String   @map("property_id")

    amenity   MasterAmenity @relation(fields: [amenityId], references: [id])
    amenityId String        @map("amenity_id")

    // Unique constraint to prevent duplicate selections
    @@unique([propertyId, amenityId])
    @@map("property_amenity_selections")
  }

  model RoomAmenitySelection {
    id String @id @default(uuid())

    room   Room   @relation(fields: [roomId], references: [id])
    roomId String @map("room_id")

    amenity   MasterAmenity @relation(fields: [amenityId], references: [id])
    amenityId String        @map("amenity_id")

    // Unique constraint to prevent duplicate selections
    @@unique([roomId, amenityId])
    @@map("room_amenity_selections")
  }

  model PropertyAddress {
    id           String  @id @default(uuid())
    addressLine1 String  @map("address_line1")
    addressLine2 String? @map("address_line2")
    country      String
    state        String
    city         String
    location     String
    landmark     String
    zipCode      String  @map("zip_code")
    latitude     Float
    longitude    Float

    property   Property @relation(fields: [propertyId], references: [id])
    propertyId String   @unique @map("property_id")

    @@map("property_addresses")
  }

  model Room {
    id                  String        @id @default(uuid())
    roomName            String        @map("room_name")
    roomType            String        @map("room_type")
    totalRoom           Int           @map("total_room")
    floor               Int
    roomView            RoomView      @default(others) @map("room_view")
    roomSize            Decimal       @map("room_size")
    roomUnit            RoomUnit      @default(sqft) @map("room_unit")
    smokingPolicy       SmokingPolicy @default(non_smoking) @map("smoking_policy")
    maxOccupancy        Int           @map("max_occupancy")
    maxNumberOfAdults   Int           @map("max_number_of_adults")
    maxNumberOfChildren Int           @map("max_number_of_children")
    numberOfBedrooms    Int           @default(1) @map("number_of_bedrooms")
    numberOfLivingRoom  Int?          @default(0) @map("number_of_living_room")
    extraBed            Int?          @default(0) @map("extra_bed")
    description         String?
    view360Link         String?       @map("360_view_link")
    image               String[]
    available           Boolean       @default(true)
    isDeleted           Boolean       @default(false) @map("is_deleted")

    property   Property @relation(fields: [propertyId], references: [id])
    propertyId String   @map("property_id")

    roomAmenities RoomAmenitySelection[]
    roomVideos    RoomVideo?
    agenticRooms  AgenticRoom[]
    geoRatePlans  GeoRatePlan[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([propertyId])
    @@index([roomType])
    @@index([available])
    @@index([isDeleted])
    @@map("rooms")
  }

  model AccessControl {
    id       String  @id @default(uuid())
    role     Role    @unique
    level    Int     @default(0)
    isActive Boolean @default(true) @map("is_active")

    // Permissions
    canCreateHotel            Boolean @default(false) @map("can_create_hotel")
    canUpdateHotel            Boolean @default(false) @map("can_update_hotel")
    canDeleteHotel            Boolean @default(false) @map("can_delete_hotel")
    canViewHotel              Boolean @default(true) @map("can_view_hotel")
    canUpdatePaymentDetails   Boolean @default(false) @map("can_update_payment_details")
    canCreateRatePlan         Boolean @default(false) @map("can_create_rate_plan")
    canViewRatePlan           Boolean @default(false) @map("can_view_rate_plan")
    canUpdateRatePlan         Boolean @default(false) @map("can_update_rate_plan")
    canDeleteRatePlan         Boolean @default(false) @map("can_delete_rate_plan")
    canAddInventory           Boolean @default(false) @map("can_add_inventory")
    canCreateRoomAvailability Boolean @default(false) @map("can_create_room_availability")
    canMapRatePlan            Boolean @default(false) @map("can_map_rate_plan")
    canUpdateRoomPrice        Boolean @default(false) @map("can_update_room_price")
    canSeeBookingDetails      Boolean @default(false) @map("can_see_booking_details")
    canUpdateBookingStatus    Boolean @default(false) @map("can_update_booking_status")
    canViewAnalytics          Boolean @default(false) @map("can_view_analytics")
    canCreateMembers          Boolean @default(false) @map("can_create_members")
    canViewMembers            Boolean @default(false) @map("can_view_members")
    canUpdateMembers          Boolean @default(false) @map("can_update_members")
    canDeleteMembers          Boolean @default(false) @map("can_delete_members")
    canCreateLevel0User       Boolean @default(false) @map("can_create_level0_user")
    canCreateLevel1User       Boolean @default(false) @map("can_create_level1_user")
    canCreateLevel2User       Boolean @default(false) @map("can_create_level2_user")
    canCreateLevel3User       Boolean @default(false) @map("can_create_level3_user")
    canUpdateLevel0User       Boolean @default(false) @map("can_update_level0_user")
    canUpdateLevel1User       Boolean @default(false) @map("can_update_level1_user")
    canUpdateLevel2User       Boolean @default(false) @map("can_update_level2_user")
    canUpdateLevel3User       Boolean @default(false) @map("can_update_level3_user")
    canDeleteLevel0User       Boolean @default(false) @map("can_delete_level0_user")
    canDeleteLevel1User       Boolean @default(false) @map("can_delete_level1_user")
    canDeleteLevel2User       Boolean @default(false) @map("can_delete_level2_user")
    canDeleteLevel3User       Boolean @default(false) @map("can_delete_level3_user")
    canViewLogs               Boolean @default(false) @map("can_view_logs")
    canCreateNewRole          Boolean @default(false) @map("can_create_new_role")
    canViewAccess             Boolean @default(false) @map("can_view_access")
    canModifyAccess           Boolean @default(false) @map("can_modify_access")
    canDeleteRole             Boolean @default(false) @map("can_delete_role")
    canCreatePolicy           Boolean @default(false) @map("can_create_policy")
    canUpdatePolicy           Boolean @default(false) @map("can_update_policy")
    canDeletePolicy           Boolean @default(false) @map("can_delete_policy")
    canCDCategory             Boolean @default(false) @map("can_cd_category")
    canCDPropertyType         Boolean @default(false) @map("can_cd_property_type")
    canCDDestinationType      Boolean @default(false) @map("can_cd_destination_type")
    canCDAmenity              Boolean @default(false) @map("can_cd_amenity")
    canSeeDraftedProperties   Boolean @default(false) @map("can_see_drafted_properties")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("access_controls")
  }

  model Charge {
    id            String       @id @default(uuid())
    propertyCode  String
    ratePlanName  String
    ratePlanCode  String
    roomTypeCode  String
    roomTypeName  String
    currencyCode  CurrencyCode @default(INR)
    date          DateTime     @db.Date
    isAvailable   Boolean      @default(true)
    // Days of week applicability
    isSaleStopped Boolean      @default(false) @map("is_sale_stopped") // for start/stop sales

    monApplicable       Boolean @default(true) @map("mon_applicable")
    tueApplicable       Boolean @default(true) @map("tue_applicable")
    wedApplicable       Boolean @default(true) @map("wed_applicable")
    thuApplicable       Boolean @default(true) @map("thu_applicable")
    friApplicable       Boolean @default(true) @map("fri_applicable")
    satApplicable       Boolean @default(true) @map("sat_applicable")
    sunApplicable       Boolean @default(true) @map("sun_applicable")
    isClosedToArrival   Boolean @default(false) @map("is_closed_to_arrival")
    isClosedToDeparture Boolean @default(false) @map("is_closed_to_departure")
    restrictionNotes    String? @map("restriction_notes")

    // Relations
    baseGuestAmounts       ChargeBaseByGuest[]
    additionalGuestAmounts ChargeAdditionalGuest[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([propertyCode, roomTypeCode, ratePlanCode, date])
    @@map("charges")
  }

  model ChargeBaseByGuest {
    id              String  @id @default(uuid())
    charge          Charge  @relation(fields: [chargeId], references: [id])
    chargeId        String
    amountBeforeTax Decimal @map("amount_before_tax")
    numberOfGuests  Int     @map("number_of_guests")

    @@index([chargeId])
    @@map("charge_base_by_guests")
  }

  model ChargeAdditionalGuest {
    id                String  @id @default(uuid())
    charge            Charge  @relation(fields: [chargeId], references: [id])
    chargeId          String
    ageQualifyingCode String  @map("age_qualifying_code")
    amount            Decimal

    @@index([chargeId])
    @@map("charge_additional_guests")
  }

  model Inventory {
    id           String   @id @default(uuid())
    propertyCode String   @map("property_code")
    roomTypeCode String   @map("room_type_code")
    date         DateTime @db.Date
    availability Int
    ratePlans    String[] @map("rate_plans")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([propertyCode])
    @@index([roomTypeCode])
    @@map("inventories")
  }

  model RatePlan {
    id              String       @id @default(uuid())
    ratePlanName    String       @map("rate_plan_name")
    ratePlanCode    String       @unique @map("rate_plan_code")
    deviceType      DeviceType[] @map("device_type")
    // Back relation to Property
    property        Property     @relation(fields: [propertyId], references: [id])
    propertyId      String       @map("property_id")
    // Policies
    depositPolicy   Policy?      @relation("RateAmountToDepositPolicy", fields: [depositPolicyId], references: [id])
    depositPolicyId String?      @map("deposit_policy_id")

    cancellationPolicy   Policy? @relation("RateAmountToCancellationPolicy", fields: [cancellationPolicyId], references: [id])
    cancellationPolicyId String? @map("cancellation_policy_id")

    guaranteePolicy   Policy? @relation("RateAmountToGuaranteePolicy", fields: [guaranteePolicyId], references: [id])
    guaranteePolicyId String? @map("guarantee_policy_id")

    taxGroup   TaxGroup? @relation(fields: [taxGroupId], references: [id])
    taxGroupId String?   @map("tax_group_id")

    b2bAvailable Boolean @default(false) @map("b2b_available")
    b2cAvailable Boolean @default(true) @map("b2c_available")

    ratePlanRules RatePlanRule?
    Addons        RatePlanWithAddon[]
    geoRatePlans  GeoRatePlan[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([propertyId])
    @@map("rate_plans")
  }

  model Policy {
    id          String     @id @default(uuid())
    policyName  String     @map("policy_name")
    type        PolicyType
    description String
    propertyId  String     @map("property_id")
    property    Property   @relation(fields: [propertyId], references: [id])

    // Reverse relations
    usedInDepositFor      RatePlan[] @relation("RateAmountToDepositPolicy")
    usedInCancellationFor RatePlan[] @relation("RateAmountToCancellationPolicy")
    usedInGuaranteeFor    RatePlan[] @relation("RateAmountToGuaranteePolicy")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([type])
    @@index([propertyId])
    @@map("policies")
  }

  model BankDetails {
    id             String  @id @default(uuid())
    payAtHotel     Boolean @default(true) @map("pay_at_hotel")
    paymentGateway Boolean @default(false) @map("payment_gateway")

    property   Property @relation(fields: [propertyId], references: [id])
    propertyId String   @unique @map("property_id")

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("bank_details")
  }

  model BookingEngineConfigurations {
    id              String   @id @default(uuid())
    property        Property @relation(fields: [propertyId], references: [id])
    propertyId      String   @unique @map("property_id")
    primaryColor    String   @map("primary_color")
    secondaryColor  String   @map("secondary_color")
    tertiaryColor   String   @map("tertiary_color")
    buttonTextColor String   @map("button_text_color")
    bannerImage     String?  @map("banner_image")
    logo            String

    @@map("booking_engine_configurations")
  }

  model PromoCode {
    id                String       @id @default(uuid())
    name              String
    code              String       @unique
    description       String?
    propertyId        String       @map("property_id")
    property          Property     @relation(fields: [propertyId], references: [id])
    discountType      DiscountType @map("discount_type")
    discountValue     Float        @map("discount_value")
    currencyCode      CurrencyCode @default(USD) @map("currency_code")
    validFrom         DateTime     @map("valid_from")
    validTo           DateTime     @map("valid_to")
    minBookingAmount  Float?       @map("min_booking_amount")
    maxDiscountAmount Float?       @map("max_discount_amount")

    isApplicableForMobileApp Boolean @default(false) @map("is_applicable_for_mobile_app")
    isApplicableForDesktop   Boolean @default(false) @map("is_applicable_for_desktop")
    isApplicableForTablet    Boolean @default(false) @map("is_applicable_for_tablet")

    isApplicableForWalkIn    Boolean @default(false) @map("is_applicable_for_walk_in")
    isApplicableForOTA       Boolean @default(false) @map("is_applicable_for_ota")
    isApplicableForCorporate Boolean @default(false) @map("is_applicable_for_corporate")

    usageLimit          Int?          @map("usage_limit")
    usageLimitPerUser   Int?          @map("usage_limit_per_user")
    applicableRoomTypes Json[]        @map("applicable_room_types")
    applicableRatePlans Json[]        @map("applicable_rate_plans")
    isActive            Boolean       @default(true) @map("is_active")
    isDeleted           Boolean       @default(false) @map("is_deleted")
    createdAt           DateTime      @default(now()) @map("created_at")
    updatedAt           DateTime      @updatedAt @map("updated_at")
    reservations        Reservation[]

    @@index([propertyId, code])
    @@index([id, code])
    @@index([propertyId, name])
    @@map("promo_codes")
  }

  model TaxRule {
    id           String          @id @default(uuid()) @map("id")
    name         String          @map("name") @db.VarChar(100)
    type         TaxType         @map("type")
