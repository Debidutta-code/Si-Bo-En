// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  super_admin
  group_manager
  brand_manager
  hotel_manager
  staff
  revenue_manager
}

enum CreationType {
  group
  property
  brand
  super
}

enum RoomView {
  city
  sea
  garden
  mountain
  others
}

enum RoomUnit {
  sqm
  sqft
}

enum SmokingPolicy {
  smoking
  non_smoking
  designated_area
}

enum CurrencyCode {
  USD
  EUR
  INR
}

enum PaymentStatus {
  confirmed
  cancelled
  pending
}

enum PolicyType {
  deposit
  guarantee
  cancellation
}

enum DeviceType {
  mobile
  tablet
  desktop
}

enum DiscountType {
  percentage
  flat
}

enum BookingStatus {
  pending
  confirmed
  cancelled
  modified
}

enum AmenityType {
  room
  property
}

enum TaxType {
  percentage
  fixed
}

enum TaxApplicableOn {
  room_rate
  total_amount
}

enum PostingRhythm {
  per_night
  per_stay
}

enum PaymentMethod {
  pay_at_hotel
  net_banking
  upi
  payment_gateway
}

enum BookingSource {
  ota
  travel_agency
}

enum FolioStatus {
  open
  closed
}

enum GuestType {
  adult
  child
  infant
}

enum userIdentityCardType {
  passport
  drivers_license
  national_id
  adhar_card
  pan_card
  others
}

enum ReservationStatus {
  reserved
  checked_in
  checked_out
  cancelled
  no_show
}

